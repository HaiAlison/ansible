# MinIO environment config
# File này được load bởi systemd service unit

# Root credentials (CHANGE IN PRODUCTION via vault)
MINIO_ROOT_USER={{ minio_root_user }}
MINIO_ROOT_PASSWORD={{ minio_root_password }}

# Data volumes
MINIO_VOLUMES="{{ minio_data_dir }}"

# Site name hiển thị trên console
MINIO_SITE_NAME="mail-merge-storage"

# Optional: console URL nếu dùng sau reverse proxy
# MINIO_BROWSER_REDIRECT_URL=https://minio-console.mail-merge.tech

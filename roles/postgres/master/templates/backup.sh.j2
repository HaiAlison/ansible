#!/bin/bash
# PostgreSQL backup script
# Generated by Ansible

BACKUP_DIR="{{ postgres_backup_dir | default('/var/backups/postgresql') }}"
DB_NAME="{{ postgres_db_name }}"
RETENTION_DAYS="{{ postgres_backup_retention_days | default(7) }}"
DATE=$(date +%Y%m%d_%H%M%S)

# Tạo backup
pg_dump -U {{ postgres_app_user }} -d $DB_NAME -F c -f $BACKUP_DIR/${DB_NAME}_${DATE}.dump

# Xóa backup cũ
find $BACKUP_DIR -name "${DB_NAME}_*.dump" -mtime +$RETENTION_DAYS -delete

# Log
echo "$(date): Backup completed: ${DB_NAME}_${DATE}.dump" >> $BACKUP_DIR/backup.log
